# docker-compose.yml reads this file automatically (must be named .env,
# in the same directory as docker-compose.yml). Copy it:
#   cp .env.example .env
# then fill in the token below.

# Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel → Docker.
# Copy the token shown there (the long string after "--token" in the
# sample docker run command Cloudflare gives you).
CLOUDFLARE_TUNNEL_TOKEN=
