# Used by docker-compose.zimaos.yml. Copy to .env next to that file:
#   cp .env.zimaos.example .env
# then fill in the values (copy AUTH_USERNAME / AUTH_PASSWORD_HASH / JWT_SECRET
# from your local server/.env, or generate fresh ones — see DOCKER-ZIMAOS.md).

AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=

# Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel → Docker.
# Copy the token shown there (the long string after "--token").
CLOUDFLARE_TUNNEL_TOKEN=
